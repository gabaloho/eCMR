<?xml version="1.0" encoding="utf-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Core theme colors -->
    <Color x:Key="Primary">#566E5E</Color>
    <Color x:Key="Secondary">#BCAAA4</Color>
    <!-- approx for Brown.Lighten2 -->
    <Color x:Key="Tertiary">#7EC380</Color>

    <Color x:Key="AppbarBackground">#566E5E</Color>
    <Color x:Key="AppbarText">#EFF1E8</Color>

    <Color x:Key="DrawerBackground">#5E6E73</Color>
    <Color x:Key="DrawerText">#EFF1E8</Color>
    <Color x:Key="DrawerIcon">#EFF1E8</Color>

    <!-- Useful semantic aliases -->
    <Color x:Key="PageBackground">#FFFFFF</Color>
    <Color x:Key="CardBackground">#FFFFFF</Color>
    <Color x:Key="PrimaryText">#111111</Color>

</ResourceDictionary>