<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="HerbavitaCMR.MainPage"
             Title="VRACHTBRIEF"
             BackgroundColor="{StaticResource PageBackground}">
    <Grid Padding="10" RowDefinitions="Auto,*">
        <!-- App bar area (you can style Shell/AppBar separately if using Shell) -->
        <Border BackgroundColor="{StaticResource AppbarBackground}" Padding="12" Grid.Row="0">
            <Label Text="VRACHTBRIEF" Style="{StaticResource Headline}" />
        </Border>
        <CollectionView x:Name="DocumentsCollectionView"
                        Grid.Row="1"
                        ItemsSource="{Binding Documents}"
                        ItemsLayout="VerticalList"
                        SelectionMode="Single"
                        SelectionChanged="Documents_SelectionChanged"
                        VerticalOptions="Fill">
            <CollectionView.EmptyView>
                <Label Text="No documents available" HorizontalOptions="Center" VerticalOptions="Center"
                       TextColor="{StaticResource PrimaryText}" />
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border Margin="6" Style="{StaticResource CardFrame}" Stroke="LightGray">
                        <VerticalStackLayout Spacing="8">
                            <!-- Document metadata -->
                            <HorizontalStackLayout Spacing="12" VerticalOptions="Center">
                                <VerticalStackLayout>
                                    <Label Text="External Id:" FontAttributes="Bold" FontSize="12" TextColor="{StaticResource PrimaryText}" />
                                    <Label Text="{Binding Id}" FontSize="12" TextColor="{StaticResource PrimaryText}" />
                                </VerticalStackLayout>
                                <VerticalStackLayout>
                                    <Label Text="Order number (external):" FontAttributes="Bold" FontSize="12" TextColor="{StaticResource PrimaryText}" />
                                    <Label Text="{Binding DocumentNumber}" FontSize="12" TextColor="{StaticResource PrimaryText}" />
                                </VerticalStackLayout>
                                <VerticalStackLayout>
                                    <Label Text="Reference:" FontAttributes="Bold" FontSize="12" TextColor="{StaticResource PrimaryText}" />
                                    <Label Text="{Binding Reference}" FontSize="12" TextColor="{StaticResource PrimaryText}" />
                                </VerticalStackLayout>
                                <VerticalStackLayout>
                                    <Label Text="Dossier number:" FontAttributes="Bold" FontSize="12" TextColor="{StaticResource PrimaryText}" />
                                    <Label Text="{Binding DossierNumber}" FontSize="12" TextColor="{StaticResource PrimaryText}" />
                                </VerticalStackLayout>
                            </HorizontalStackLayout>
                            <HorizontalStackLayout Spacing="12" VerticalOptions="Center">
                                <VerticalStackLayout>
                                    <Label Text="Issued date:" FontAttributes="Bold" FontSize="12" TextColor="{StaticResource PrimaryText}" />
                                    <Label Text="{Binding CreationTimestamp, StringFormat='Issued: {0:yyyy-MM-dd HH:mm}'}" FontSize="12" TextColor="{StaticResource PrimaryText}" />
                                </VerticalStackLayout>
                                <!-- Issued place (PrimaryExpeditor) -->
                                <VerticalStackLayout>
                                    <Label Text="Issued place:" FontAttributes="Bold" FontSize="12" TextColor="{StaticResource PrimaryText}" />
                                    <Label FontSize="12" TextColor="{StaticResource PrimaryText}">
                                        <Label.FormattedText>
                                            <FormattedString>
                                                <Span Text="{Binding PrimaryExpeditor.Address, FallbackValue={Binding Address}}" />
                                                <Span Text=" " />
                                                <Span Text="{Binding PrimaryExpeditor.Postcode, FallbackValue={Binding Postcode}}" />
                                                <Span Text=" " />
                                                <Span Text="{Binding PrimaryExpeditor.City, FallbackValue={Binding City}}" />
                                                <Span Text=", " />
                                                <Span Text="{Binding PrimaryExpeditor.CountryCode, FallbackValue={Binding CountryCode}}" />
                                                <Span Text=", " />
                                                <Span Text="{Binding PrimaryExpeditor.Country, FallbackValue={Binding Country}}" />
                                            </FormattedString>
                                        </Label.FormattedText>
                                    </Label>
                                </VerticalStackLayout>
                            </HorizontalStackLayout>
                            <!-- Consignor: PrimaryExpeditor -->
                            <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                                <VerticalStackLayout>
                                    <Label Text="Consignor:" FontAttributes="Bold" FontSize="14" TextColor="{StaticResource PrimaryText}" />
                                    <Label Text="{Binding PrimaryExpeditor.CompanyName, FallbackValue={Binding Customer}}" FontSize="14" TextColor="{StaticResource PrimaryText}" />
                                    <Label Text="{Binding PrimaryExpeditor.EmailAddress, FallbackValue=''}" FontSize="12" TextColor="Gray" />
                                </VerticalStackLayout>
                            </HorizontalStackLayout>
                            <Label FontSize="14" TextColor="{StaticResource PrimaryText}">
                                <Label.FormattedText>
                                    <FormattedString>
                                        <Span Text="{Binding PrimaryExpeditor.Address, FallbackValue={Binding Address}}" />
                                        <Span Text=" " />
                                        <Span Text="{Binding PrimaryExpeditor.Postcode, FallbackValue={Binding Postcode}}" />
                                        <Span Text=" " />
                                        <Span Text="{Binding PrimaryExpeditor.City, FallbackValue={Binding City}}" />
                                        <Span Text=", " />
                                        <Span Text="{Binding PrimaryExpeditor.CountryCode, FallbackValue={Binding CountryCode}}" />
                                        <Span Text=", " />
                                        <Span Text="{Binding PrimaryExpeditor.Country, FallbackValue={Binding Country}}" />
                                    </FormattedString>
                                </Label.FormattedText>
                            </Label>
                            <!-- Consignee -->
                            <VerticalStackLayout Spacing="2" Padding="0,4,0,0">
                                <Label Text="Consignee (receiver):" FontAttributes="Bold" FontSize="14" TextColor="{StaticResource PrimaryText}" />
                                <Label Text="{Binding PrimaryConsignee.CompanyName, FallbackValue={Binding Customer}}" FontSize="14" TextColor="{StaticResource PrimaryText}" />
                                <Label FontSize="12" TextColor="{StaticResource PrimaryText}">
                                    <Label.FormattedText>
                                        <FormattedString>
                                            <Span Text="{Binding PrimaryConsignee.Address, FallbackValue={Binding Address}}" />
                                            <Span Text=" " />
                                            <Span Text="{Binding PrimaryConsignee.Postcode, FallbackValue={Binding Postcode}}" />
                                            <Span Text=" " />
                                            <Span Text="{Binding PrimaryConsignee.City, FallbackValue={Binding City}}" />
                                            <Span Text=", " />
                                            <Span Text="{Binding PrimaryConsignee.CountryCode, FallbackValue={Binding CountryCode}}" />
                                            <Span Text=", " />
                                            <Span Text="{Binding PrimaryConsignee.Country, FallbackValue={Binding Country}}" />
                                        </FormattedString>
                                    </Label.FormattedText>
                                </Label>
                            </VerticalStackLayout>
                            <!-- Primary carrier: PrimaryShipper -->
                            <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                                <VerticalStackLayout>
                                    <Label Text="PrimaryCarrier:" FontAttributes="Bold" FontSize="14" TextColor="{StaticResource PrimaryText}" />
                                    <Label Text="{Binding PrimaryShipper.CompanyName, FallbackValue=''}" FontSize="14" TextColor="{StaticResource PrimaryText}" />
                                    <Label Text="{Binding PrimaryShipper.EmailAddress, FallbackValue=''}" FontSize="12" TextColor="Gray" />
                                </VerticalStackLayout>
                            </HorizontalStackLayout>
                            <Label FontSize="14" TextColor="{StaticResource PrimaryText}">
                                <Label.FormattedText>
                                    <FormattedString>
                                        <Span Text="{Binding PrimaryShipper.Address, FallbackValue=''}" />
                                        <Span Text=" " />
                                        <Span Text="{Binding PrimaryShipper.Postcode, FallbackValue=''}" />
                                        <Span Text=" " />
                                        <Span Text="{Binding PrimaryShipper.City, FallbackValue=''}" />
                                        <Span Text=", " />
                                        <Span Text="{Binding PrimaryShipper.CountryCode, FallbackValue=''}" />
                                        <Span Text=", " />
                                        <Span Text="{Binding PrimaryShipper.Country, FallbackValue=''}" />
                                    </FormattedString>
                                </Label.FormattedText>
                            </Label>
                            <!-- Pickup -->
                            <VerticalStackLayout Spacing="2" Padding="4,0,0,0">
                                <Label Text="Pickup (pickup):" FontAttributes="Bold" FontSize="14" TextColor="{StaticResource PrimaryText}" />
                                <Label Text="{Binding ShipmentDeliveryDate, StringFormat='Pickup: {0:yyyy-MM-dd HH:mm}'}" FontSize="12" TextColor="{StaticResource PrimaryText}" />
                                <Label Text="{Binding PickupReference}" FontSize="12" TextColor="{StaticResource PrimaryText}"/>
                                <!-- Pickup address (PrimaryExpeditor) -->
                                <Label FontSize="14" TextColor="{StaticResource PrimaryText}">
                                    <Label.FormattedText>
                                        <FormattedString>
                                            <Span Text="{Binding PrimaryExpeditor.Address, FallbackValue={Binding Address}}" />
                                            <Span Text=" " />
                                            <Span Text="{Binding PrimaryExpeditor.Postcode, FallbackValue={Binding Postcode}}" />
                                            <Span Text=" " />
                                            <Span Text="{Binding PrimaryExpeditor.City, FallbackValue={Binding City}}" />
                                            <Span Text=", " />
                                            <Span Text="{Binding PrimaryExpeditor.CountryCode, FallbackValue={Binding CountryCode}}" />
                                            <Span Text=", " />
                                            <Span Text="{Binding PrimaryExpeditor.Country, FallbackValue={Binding Country}}" />
                                        </FormattedString>
                                    </Label.FormattedText>
                                </Label>
                            </VerticalStackLayout>
                            <!-- Delivery -->
                            <VerticalStackLayout Spacing="2" Padding="4,0,0,0">
                                <Label Text="Delivery (delivery):" FontAttributes="Bold" FontSize="14" TextColor="{StaticResource PrimaryText}" />
                                <Label Text="{Binding DeliveryDateTime, StringFormat='Delivery: {0}'}" FontSize="12" TextColor="{StaticResource PrimaryText}"/>
                                <Label Text="{Binding PickupReference}" FontSize="12" TextColor="{StaticResource PrimaryText}"/>
                                <!-- Reuse ref or customize -->
                                <Label FontSize="14" TextColor="{StaticResource PrimaryText}">
                                    <Label.FormattedText>
                                        <FormattedString>
                                            <Span Text="{Binding PrimaryConsignee.Address, FallbackValue={Binding Address}}" />
                                            <Span Text=" " />
                                            <Span Text="{Binding PrimaryConsignee.Postcode, FallbackValue={Binding Postcode}}" />
                                            <Span Text=" " />
                                            <Span Text="{Binding PrimaryConsignee.City, FallbackValue={Binding City}}" />
                                            <Span Text=", " />
                                            <Span Text="{Binding PrimaryConsignee.CountryCode, FallbackValue={Binding CountryCode}}" />
                                            <Span Text=", " />
                                            <Span Text="{Binding PrimaryConsignee.Country, FallbackValue={Binding Country}}" />
                                        </FormattedString>
                                    </Label.FormattedText>
                                </Label>
                            </VerticalStackLayout>
                            <Label Text="Vervorde goederen (goods):" FontAttributes="Bold" FontSize="14"
                                   TextColor="{StaticResource PrimaryText}" />
                            <!-- Goods: PrimaryPalletItems -->
                            <CollectionView ItemsSource="{Binding PrimaryPalletItemViews}"
                                            ItemsLayout="VerticalList"
                                            SelectionMode="None"
                                            VerticalOptions="Fill">
                                <CollectionView.ItemTemplate>
                                    <DataTemplate>
                                        <VerticalStackLayout Padding="4" Spacing="2">
                                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12" VerticalOptions="Center">
                                                <Label Grid.Column="0"
                                                       Text="{Binding ItemNumber}"
                                                       WidthRequest="120"
                                                       FontAttributes="Bold"
                                                       VerticalOptions="Center"
                                                       TextColor="{StaticResource PrimaryText}" />

                                                <!-- Description + Quantity close together -->
                                                <Grid Grid.Column="1" ColumnDefinitions="*,Auto" ColumnSpacing="6" VerticalOptions="Center">
                                                    <Label Grid.Column="0"
                                                           Text="{Binding Description}"
                                                           LineBreakMode="TailTruncation"
                                                           FontSize="12"
                                                           VerticalOptions="Center"
                                                           TextColor="{StaticResource PrimaryText}" />
                                                    <Label Grid.Column="1"
                                                           FontSize="12"
                                                           VerticalOptions="Center"
                                                           TextColor="{StaticResource PrimaryText}">
                                                        <Label.FormattedText>
                                                            <FormattedString>
                                                                <!-- show net and gross weight, keep gross present -->
                                                                <Span Text="{Binding NetWeight, StringFormat='Net: {0:0.##}'}" />
                                                                <Span Text=" " />
                                                                <Span Text="{Binding UnitOfMeasure}" />
                                                                <Span Text="  /  " />
                                                                <Span Text="{Binding GrossWeight, StringFormat='Gross: {0:0.##} kg'}" />
                                                            </FormattedString>
                                                        </Label.FormattedText>
                                                    </Label>
                                                </Grid>
                                            </Grid>

                                            <!-- ADR text for this item (may be empty). Show below the item; multi-language grouped. -->
                                            <Label Text="{Binding AdrTextAllLanguages}"
                                                   FontSize="12"
                                                   TextColor="{StaticResource PrimaryText}"
                                                   LineBreakMode="WordWrap"
                                                   Margin="4,0,0,0" />
                                        </VerticalStackLayout>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                            </CollectionView>

                            <!-- Pallet summary -->
                            <VerticalStackLayout Spacing="2" Padding="4,0,0,0">
                                <Label Text="{Binding PalletCount, StringFormat='Antal palleten: {0}'}"
                                       FontAttributes="Bold"
                                       FontSize="14"
                                       TextColor="{StaticResource PrimaryText}" />
                                <Label Text="{Binding PalletTotalWeight, StringFormat='Totaal gewicht: {0:0.##} kg'}"
                                       FontSize="14"
                                       TextColor="{StaticResource PrimaryText}" />
                            </VerticalStackLayout>
                            <!-- Empties, successive carriers, transport executions, eCMR toggle left unchanged -->
                            <!-- (they still bind into nested structures; add convenience props if needed) -->
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>